# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.out
coverage.html

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Binary output directory
bin/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db

# Project specific
*.log
*.tmp
/tmp/
nohup.out

# Built binaries (will be auto-generated by CI)
gamebook
/gamebook

# Archives directory (for old hearing files)
archives/
data/

# Game play records - exclude all markdown files that are game data
*.md
!README.md
!SPECIFICATION.md
!DEVELOPMENT.md
!CLAUDE.md
!PLAY_FEEDBACK.md
!CHANGELOG.md
!LICENSE.md
!docs/*.md
!.github/**/*.md